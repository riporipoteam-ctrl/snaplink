{
  "name": "SnapLink",
  "short_name": "SnapLink",
  "id": "/",
  "description": "SnapLink social hub for posts, messages, stories, calls, events, and RipoAI.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#020617",
  "theme_color": "#0b4bff",
  "icons": [
    {
      "src": "/favicon.svg?v=20260504",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/apple-touch-icon.png?v=20260504",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/snaplink-icon-192.png?v=20260504",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/snaplink-icon-512.png?v=20260504",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/snaplink-maskable-512.png?v=20260504",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Home",
      "short_name": "Home",
      "url": "/",
      "icons": [{ "src": "/icons/snaplink-icon-192.png?v=20260504", "sizes": "192x192" }]
    },
    {
      "name": "Messages",
      "short_name": "Messages",
      "url": "/messages",
      "icons": [{ "src": "/icons/snaplink-icon-192.png?v=20260504", "sizes": "192x192" }]
    },
    {
      "name": "RipoAI",
      "short_name": "RipoAI",
      "url": "/ripoai",
      "icons": [{ "src": "/icons/snaplink-icon-192.png?v=20260504", "sizes": "192x192" }]
    }
  ]
}
