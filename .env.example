# Server-side RipoAI provider key for the Netlify function.
GROQ_API_KEY="your_groq_api_key"

# Optional chat model override for the Netlify function.
GROQ_MODEL="qwen/qwen3-32b"

# Optional vision model override for the Netlify function.
GROQ_VISION_MODEL="meta-llama/llama-4-scout-17b-16e-instruct"

# Optional coding model override for the Netlify function.
GROQ_CODE_MODEL="openai/gpt-oss-120b"

# Public site URL used by sitemap/robots generation.
SITE_URL="https://snaplinknetwork.netlify.app"
